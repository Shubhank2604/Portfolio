{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/work", "destination": "/projects/", "permanent": true },
    { "source": "/work/:slug", "destination": "/projects/:slug/", "permanent": true }
  ]
}
